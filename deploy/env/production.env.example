# Charted Environment Variables
# Copy this file and fill in the values

# Convex deployment name (e.g., content-iguana-935)
CONVEX_DEPLOYMENT=

# Convex site URL (e.g., https://content-iguana-935.convex.site)
CONVEX_SITE_URL=

# JWT Private Key (PKCS#8 format, base64 encoded)
JWT_PRIVATE_KEY=

# JWKS (public key components, JSON format)
JWKS=
